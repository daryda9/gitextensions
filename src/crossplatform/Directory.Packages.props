<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AdysTech.CredentialManager" Version="2.3.0" />
    <PackageVersion Include="Avalonia" Version="11.3.14" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.14" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.14" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.14" />
    <!-- The Avalonia port of ICSharpCode's editor, which is what upstream's
         FileViewerInternal hosts on Windows. Pinned to the 11.3 line because
         AvaloniaEdit ships one build per Avalonia minor: 11.4.x compiles against
         Avalonia 11.4 APIs and would only fail at run time on our 11.3.14. -->
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <PackageVersion Include="Ben.Demystifier" Version="0.4.1" />
    <PackageVersion Include="JetBrains.Annotations" Version="2021.2.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Composition" Version="17.2.41" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading" Version="17.13.61" />
    <!-- Skia is already in the process: it is Avalonia's rendering backend, and
         every Bitmap the port shows was decoded by it. Referenced directly so the
         image diff can ask the decoder a question Avalonia's Bitmap has no API
         for — "did the bytes run out before the picture did?" — which is the
         difference between a half-downloaded PNG shown as if it were the file and
         a half-downloaded PNG labelled as one. Pinned to the exact version
         Avalonia.Skia 11.3.14 depends on: two SkiaSharp builds in one process
         would fight over the same native library. -->
    <PackageVersion Include="SkiaSharp" Version="2.88.9" />
    <PackageVersion Include="StrongOf" Version="1.2.4" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
    <PackageVersion Include="System.IO.Abstractions" Version="22.0.12" />
    <PackageVersion Include="System.Reactive" Version="5.0.0" />
    <PackageVersion Include="System.Reactive.Interfaces" Version="5.0.0" />
    <PackageVersion Include="System.Reactive.Linq" Version="5.0.0" />
  </ItemGroup>
</Project>
