<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>GitExtensions.Avalonia</RootNamespace>
    <AssemblyName>GitExtensions.Avalonia</AssemblyName>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reuse the original Git Extensions icon set (WinForms resources) as
         Avalonia resources, exposed under avares://…/Assets/Icons/<name>.png. -->
    <AvaloniaResource Include="..\..\app\GitUI\Resources\Icons\*.png">
      <Link>Assets/Icons/%(Filename)%(Extension)</Link>
    </AvaloniaResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.GitCommands.csproj" />
  </ItemGroup>

</Project>
