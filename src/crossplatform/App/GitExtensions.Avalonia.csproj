<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>GitExtensions.Avalonia</RootNamespace>
    <AssemblyName>GitExtensions.Avalonia</AssemblyName>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- Product version shown in the About dialog. Single source of truth is
       packaging/VERSION, the same file build-deb.sh stamps into the .deb, so the
       version the user sees in the UI can never disagree with the package. -->
  <PropertyGroup>
    <_PackagingVersionFile>$(MSBuildThisFileDirectory)..\packaging\VERSION</_PackagingVersionFile>
    <Version>5.0.0</Version>
    <!-- The SDK otherwise appends "+<full sha>" to the informational version; the
         About dialog shows the (short) commit on its own "Build" line. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('$(_PackagingVersionFile)')">
    <_RawPackagingVersion>$([System.IO.File]::ReadAllText('$(_PackagingVersionFile)'))</_RawPackagingVersion>
    <InformationalVersion>$(_RawPackagingVersion.Trim())</InformationalVersion>
  </PropertyGroup>

  <!-- Build provenance: the commit the binary was built from, and whether the
       tree was dirty at the time. Upstream gets this from the GitInfo package
       (ThisAssembly.Git.Sha / IsDirty), which is not restorable in this offline
       tree, so ask git directly and stash the answer in assembly metadata —
       AboutDialog reads it back through AssemblyMetadataAttribute. A missing git,
       or a source drop with no .git, just leaves the metadata absent. -->
  <Target Name="StampBuildProvenance" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-parse --short=10 HEAD"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true" StandardOutputImportance="low"
          ContinueOnError="true" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_BuildGitSha" />
      <Output TaskParameter="ExitCode" PropertyName="_BuildGitShaExit" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=no"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true" StandardOutputImportance="low"
          ContinueOnError="true" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_BuildGitStatus" />
    </Exec>
    <PropertyGroup>
      <_BuildGitIsDirty>false</_BuildGitIsDirty>
      <_BuildGitIsDirty Condition="'$(_BuildGitStatus.Trim())' != ''">true</_BuildGitIsDirty>
    </PropertyGroup>
    <ItemGroup Condition="'$(_BuildGitShaExit)' == '0' AND '$(_BuildGitSha)' != ''">
      <AssemblyMetadata Include="BuildGitSha" Value="$(_BuildGitSha.Trim())" />
      <AssemblyMetadata Include="BuildGitIsDirty" Value="$(_BuildGitIsDirty)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Reuse the original Git Extensions icon set (WinForms resources) as
         Avalonia resources, exposed under avares://…/Assets/Icons/<name>.png. -->
    <AvaloniaResource Include="..\..\app\GitUI\Resources\Icons\*.png">
      <Link>Assets/Icons/%(Filename)%(Extension)</Link>
    </AvaloniaResource>

    <!-- The illustrative help diagrams upstream shows in the left column of the
         merge/pull/rebase dialogs (HelpImageDisplayUserControl). Linked, never
         copied: src/app/GitUI/Resources/Help is shared source for the Windows
         build. Exposed as avares://…/Assets/Help/<name>.png, the names
         HelpImagePanel asks for — the resource lookup is case-sensitive. -->
    <AvaloniaResource Include="..\..\app\GitUI\Resources\Help\*.png">
      <Link>Assets/Help/%(Filename)%(Extension)</Link>
    </AvaloniaResource>

    <!-- The wide product wordmark drawn on the dashboard's branding strip
         (upstream Dashboard.Designer.cs). It lives in setup/assets/Logo, outside
         the icon glob above, so it needs its own item to become resolvable as
         avares://…/Assets/Icons/GitExtensionsLogoWide.png — the name
         DashboardView.Branding() asks IconLoader for. -->
    <AvaloniaResource Include="..\..\..\setup\assets\Logo\GitExtensionsLogoWide.png">
      <Link>Assets/Icons/%(Filename)%(Extension)</Link>
    </AvaloniaResource>
    <!-- The square product logo for the About dialog, upstream's
         logoPictureBox / Properties.Images.GitExtensionsLogo256. The icon glob
         above covers only src/app/GitUI/Resources/Icons, which has no square
         product logo, so AboutDialog's IconLoader.Image("GitExtensions", 48) was
         logging "did not resolve" on every start and silently rendering no icon.
         Linked under the name the dialog asks for. -->
    <AvaloniaResource Include="..\..\..\setup\assets\Logo\git-extensions-logo-128px.png">
      <Link>Assets/Icons/GitExtensions.png</Link>
    </AvaloniaResource>
  </ItemGroup>

  <ItemGroup>
    <!-- XLIFF translation catalogues. The core engine
         (GitExtensions.Extensibility.Translations.Translator.GetTranslationDir)
         looks for them in "<directory of the Extensibility assembly>/Translation",
         which for this app is "$(OutDir)Translation" — and, after `dotnet publish`,
         "$(PublishDir)Translation", which build-deb.sh copies wholesale into the
         package. Without this item group no .xlf ever reaches the output and the
         port is English by construction.
         The *.Plugins.xlf files are included on purpose: Translator enumerates
         "<language>*.xlf", so they are part of a language's catalogue. -->
    <None Include="..\..\app\GitUI\Translation\*.xlf"
          Link="Translation\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.GitCommands.csproj" />
  </ItemGroup>

</Project>
