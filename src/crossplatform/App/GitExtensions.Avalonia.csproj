<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>GitExtensions.Avalonia</RootNamespace>
    <AssemblyName>GitExtensions.Avalonia</AssemblyName>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reuse the original Git Extensions icon set (WinForms resources) as
         Avalonia resources, exposed under avares://…/Assets/Icons/<name>.png. -->
    <AvaloniaResource Include="..\..\app\GitUI\Resources\Icons\*.png">
      <Link>Assets/Icons/%(Filename)%(Extension)</Link>
    </AvaloniaResource>
  </ItemGroup>

  <ItemGroup>
    <!-- XLIFF translation catalogues. The core engine
         (GitExtensions.Extensibility.Translations.Translator.GetTranslationDir)
         looks for them in "<directory of the Extensibility assembly>/Translation",
         which for this app is "$(OutDir)Translation" — and, after `dotnet publish`,
         "$(PublishDir)Translation", which build-deb.sh copies wholesale into the
         package. Without this item group no .xlf ever reaches the output and the
         port is English by construction.
         The *.Plugins.xlf files are included on purpose: Translator enumerates
         "<language>*.xlf", so they are part of a language's catalogue. -->
    <None Include="..\..\app\GitUI\Translation\*.xlf"
          Link="Translation\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.GitCommands.csproj" />
  </ItemGroup>

</Project>
